{
  "name": "dotli",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/dotli.git"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "build:prod": "turbo run build:prod",
    "build:test": "VITE_NETWORKS=paseo-next-v2,previewnet VITE_METRICS=true VITE_SENTRY_DSN=http://publickey@127.0.0.1:5173/1 npm run build",
    "dev": "turbo run dev",
    "preview": "turbo run build && node scripts/preview-server.ts",
    "preview:debug": "VITE_APP_DEBUG=true npm run preview",
    "serve": "node scripts/serve.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:vrt": "VRT=1 vitest run --config vitest.storybook.config.ts",
    "test": "turbo run test test:root",
    "test:root": "node --test scripts/*.test.ts",
    "test:e2e:local": "E2E_PRODUCT_URL=${E2E_PRODUCT_URL:-http://localhost:5199} npm run link:truapi && VITE_NETWORKS=paseo-next-v2,previewnet VITE_APP_DEBUG=true npm run build && npm run --workspace apps/host test:e2e:local",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint .",
    "knip": "knip",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit -p .",
    "set-version": "node scripts/set-version.ts",
    "link:truapi": "node scripts/link-truapi-local.ts",
    "unlink:truapi": "node scripts/unlink-truapi-local.ts",
    "clean": "find . -type d \\( -name node_modules -o -name dist \\) -prune -exec rm -rf {} +",
    "prepare": "husky"
  },
  "devDependencies": {
    "@config/eslint": "*",
    "@config/storybook": "*",
    "@config/vite": "*",
    "@dotli/config": "*",
    "@dotli/ui": "*",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.3",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "storybook": "^10.6.2",
    "storybook-solidjs-vite": "^10.7.4",
    "terser": "^5.51.2",
    "turbo": "^2.11.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "npm@12.2.0",
  "workspaces": [
    "apps/*",
    "config/*",
    "packages/*"
  ],
  "dependencies": {
    "@parity/truapi": "0.26.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@sentry/cli": false,
    "esbuild": false,
    "fsevents": false
  }
}
