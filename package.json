{
  "name": "dotli",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/dotli.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "build:prod": "turbo run build:prod",
    "preview": "turbo run build && bun scripts/preview-server.ts",
    "preview:debug": "VITE_APP_DEBUG=true bun preview",
    "serve": "bun scripts/serve.ts",
    "test": "turbo run test",
    "test:e2e:local": "E2E_PRODUCT_REPO=${E2E_PRODUCT_REPO:-../../../host-playground} E2E_PRODUCT_URL=${E2E_PRODUCT_URL:-http://localhost:5199} bun run link:truapi && VITE_NETWORKS=paseo-next-v2,previewnet VITE_APP_DEBUG=true bun run build && bun run --cwd apps/host test:e2e:local",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "typecheck": "turbo run typecheck",
    "set-version": "bun scripts/set-version.ts",
    "link:truapi": "bun scripts/link-truapi-local.ts",
    "unlink:truapi": "bun scripts/unlink-truapi-local.ts",
    "clean": "find . -type d \\( -name node_modules -o -name dist \\) -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "smoldot": "3.4.1"
  },
  "overrides": {
    "@parity/truapi": "0.9.0",
    "fast-uri": "3.1.5",
    "smoldot": "3.4.1",
    "esbuild": "^0.28.1",
    "brace-expansion": "^5.0.9",
    "postcss": "^8.5.24",
    "nanoid": "^3.3.18"
  }
}
