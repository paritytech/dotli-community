{
  "name": "dotli",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/dotli.git"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "build:prod": "turbo run build:prod",
    "preview": "turbo run build && node scripts/preview-server.ts",
    "preview:debug": "VITE_APP_DEBUG=true npm run preview",
    "serve": "node scripts/serve.ts",
    "test": "turbo run test",
    "test:e2e:local": "E2E_PRODUCT_REPO=${E2E_PRODUCT_REPO:-../../../host-playground} E2E_PRODUCT_URL=${E2E_PRODUCT_URL:-http://localhost:5199} npm run link:truapi && VITE_NETWORKS=paseo-next-v2,previewnet VITE_APP_DEBUG=true npm run build && npm run --workspace apps/host test:e2e:local",
    "lint": "turbo run lint lint:root",
    "lint:root": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,astro}\"",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit -p .",
    "set-version": "node scripts/set-version.ts",
    "link:truapi": "node scripts/link-truapi-local.ts",
    "unlink:truapi": "node scripts/unlink-truapi-local.ts",
    "clean": "find . -type d \\( -name node_modules -o -name dist \\) -prune -exec rm -rf {} +"
  },
  "devDependencies": {
    "@dotli/config": "*",
    "@dotli/eslint-config": "*",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "terser": "^5.51.2",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "npm@12.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@parity/truapi": "0.23.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "allowScripts": {
    "@sentry/cli": false,
    "esbuild": false,
    "fsevents": false
  }
}
