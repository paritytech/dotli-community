{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "agentGuidance": false,
  "globalEnv": ["DEV", "SSR", "BASE_URL", "NODE_ENV", "VITE_*", "DOTLI_NETWORK"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "cache": false
    },
    "build:prod": {
      "dependsOn": ["^build:prod"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"],
      "env": ["SENTRY_AUTH_TOKEN"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#typecheck:root": {
      "outputs": []
    }
  }
}
