{
  "extends": ["@config/typescript/base.json", "@config/typescript/solid.json"],
  "compilerOptions": {
    // Unit specs run under Node, so they may use ES2024 APIs such as Promise.withResolvers. tsconfig.shipped.json holds
    // shipped code to the browsers' ES2022.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "eslint.config.js", "vitest.config.ts"]
}
