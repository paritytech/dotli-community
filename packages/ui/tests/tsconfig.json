{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    // The tests run under Node (engines >= 22) with happy-dom, not in the
    // browsers src targets, so they may use ES2024 APIs such as
    // Promise.withResolvers.
    "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  // The ambient ring-VRF glue declaration lives in src, which this project reaches only through imports.
  "include": [".", "../src/truapi-verifiable.d.ts"]
}
