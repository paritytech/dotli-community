{
  "name": "@dotli/host-cli",
  "version": "0.1.0",
  "private": false,
  "description": "Terminal host for the TrUAPI Rust/WASM core: pairing QR, confirm prompts, owner-only file storage, and pooled chain connections for CLI products.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paritytech/dotli-community.git",
    "directory": "packages/host-cli"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "bunx eslint src/ tests/",
    "test": "vitest run"
  },
  "dependencies": {
    "@parity/truapi-host": "0.6.0",
    "neverthrow": "^8.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@dotli/eslint-config": "workspace:*",
    "@dotli/typescript-config": "workspace:*",
    "@parity/truapi": "0.9.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.5.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  }
}
