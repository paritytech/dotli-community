{
  "name": "@dotli/ui-widgets",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./views": "./src/views.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.shipped.json && tsc --noEmit -p tests",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:vrt": "VRT=1 vitest run --config vitest.storybook.config.ts"
  },
  "devDependencies": {
    "@config/eslint": "*",
    "@config/storybook": "*",
    "@config/typescript": "*",
    "@config/vite": "*",
    "@dotli/shared": "*",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "storybook": "^10.6.1",
    "storybook-solidjs-vite": "^10.7.2"
  },
  "dependencies": {
    "@dotli/ui": "*",
    "@dotli/ui-core": "*",
    "@solidjs/web": "2.0.0-rc.13",
    "solid-js": "2.0.0-rc.13"
  }
}
