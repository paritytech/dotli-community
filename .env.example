# App URL - used for asset base path (e.g. https://paseo.li, http://localhost:5173)
VITE_APP_URL=

# Destination for the "Get Polkadot Desktop" banner shown on non-mobile
# user agents. When unset, falls back to
# https://polkadot.com/get-started/polkadot-for-desktop.
VITE_DESKTOP_DOWNLOAD_URL=

# Required. Comma-separated networks this build offers in the Settings
# selector. Each value must match a `NetworkName` in
# `packages/config/src/network.ts`.
VITE_NETWORKS=

# Set to "true" to let this build take its network configuration at run time
# from `/dotli-network.js` (see docs/docker.md). Off by default and off in the
# hosted deployments: the config can repoint RPC endpoints, so a build that
# honours it hands anything running in the page a documented hook into network
# configuration. Only the prebuilt artifacts — the container image and the
# release tarball — turn it on.
VITE_RUNTIME_NETWORK_CONFIG=

# WebSocket endpoint for the developer-only PolkaVM TCP relay. Without this
# value, computer apps boot with networking disabled.
# Allowed origins can open raw TCP connections without proof of a Host grant.
# Keep this empty in builds serving untrusted JavaScript applications.
VITE_POLKAVM_TCP_RELAY_URL=

# Relay process policy. The relay binds loopback only. An origin allowlist is
# not authentication: do not expose this listener through a public proxy.
# Production requires an explicit allowlist. Ports default to HTTP and HTTPS.
POLKAVM_TCP_ALLOWED_ORIGINS=
POLKAVM_TCP_ALLOWED_PORTS=80,443
POLKAVM_TCP_RELAY_PORT=8787

# Set to "true" to enable verbose `log.debug` output (see
# packages/shared/src/log.ts) and auto-mount the TrUAPI debug panel
# (collapsed) on page load. Users can also opt in at runtime in any
# build via the Settings "Open in debug mode" button or `?debug=true`.
VITE_APP_DEBUG=

# Set to "true" to send spans/measurements/counters to Sentry and keep the
# analytics SDKs in the bundle. Unset/empty (the default) makes all metric
# calls no-ops and strips the Sentry/metrics modules from the build.
VITE_METRICS=

# Set (to any non-empty value) to activate the sandbox-checker tooling at
# build time (see packages/sandbox-checker). Leave unset for normal builds.
VITE_SANDBOX_CHECKER=

# Optional relay chain spec override for the statement store people chain.
# Chain-spec file name without `.json`, e.g. "westend-local". When unset,
# the default Paseo relay chain is reused.
VITE_SS_RELAY_CHAIN=

# Commit SHA stamped into the build.
VITE_COMMIT_SHA=

# Sentry DSN for browser error reporting. When unset, Sentry is a no-op.
VITE_SENTRY_DSN=

# Sentry sourcemap upload token.
SENTRY_AUTH_TOKEN=

# E2E (apps/host/tests/e2e) — pairing and signing via the truapi-host CLI
# from paritytech/host-rust-core. Install it with the repo's installer script
# or set SIGNING_HOST_BIN to a locally built binary (defaults to PATH lookup).
SIGNING_HOST_BIN=
# MUST match the host's `defaultNetwork()` in `packages/config/src/network.ts`.
# Drift produces a silent "pair OK, user-badge never appears" failure: the
# CLI attests on one chain, the host listens on another, and the chain-side
# handshake never reaches the host.
SIGNING_HOST_NETWORK=paseo-next-v2
# CLI state dir (accounts, sessions). Defaults to apps/host/tests/e2e/.auth/
# signing-host so repeat runs reuse one test account. Override to isolate.
SIGNING_HOST_BASE_PATH=
# Optional: sign as a specific account instead of an auto-registered
# dotlitest user. Also read from the shell environment if exported.
HOST_CLI_SIGNER_MNEMONIC=
