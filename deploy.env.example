# Copy to deploy.env (gitignored). The Makefile includes it, so use Make assignment syntax.
# REMOTE_STG is the fallback for every non-prod env. Each env runs on its own server, so REMOTE=user@host overrides
# either per run.

REMOTE_PRD := ubuntu@your.production.host
REMOTE_STG := ubuntu@your.staging.host

# Optional, the same value CI passes as VITE_SENTRY_DSN. Leave unset to skip the /t tunnel.
# SENTRY_DSN := https://<key>@<org>.ingest.<region>.sentry.io/<project-id>
