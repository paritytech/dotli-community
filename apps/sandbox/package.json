{
  "name": "@dotli/sandbox",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": [
    "./src/boot.ts",
    "./src/main.ts"
  ],
  "scripts": {
    "build": "vite build",
    "build:prod": "vite build && node ../../scripts/compress-dist.ts",
    "dev": "vite",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:vrt": "VRT=1 vitest run --config vitest.storybook.config.ts"
  },
  "devDependencies": {
    "@config/eslint": "*",
    "@config/storybook": "*",
    "@config/typescript": "*",
    "@config/vite": "*",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "fake-indexeddb": "^6.2.5",
    "storybook": "^10.6.2",
    "storybook-solidjs-vite": "^10.7.2"
  },
  "dependencies": {
    "@dotli/config": "*",
    "@dotli/content": "*",
    "@dotli/metrics": "*",
    "@dotli/sandbox-wire": "*",
    "@dotli/shared": "*",
    "@dotli/ui": "*",
    "@solidjs/web": "2.0.0-rc.15",
    "solid-js": "2.0.0-rc.15"
  }
}
