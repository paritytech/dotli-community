{
  "name": "@dotli/host",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "build": "tsc && bunx --bun vite build",
    "build:prod": "tsc && bunx --bun vite build && bun ../../scripts/compress-dist.ts",
    "test": "vitest run",
    "test:functional": "playwright test --config=tests/functional/playwright.config.ts tests/functional/loading.spec.ts tests/functional/resolution.spec.ts tests/functional/navigation.spec.ts tests/functional/network-transport.spec.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:local": "E2E_PRODUCT_URL=${E2E_PRODUCT_URL:-http://localhost:5199} SIGNING_HOST_NETWORK=${SIGNING_HOST_NETWORK:-paseo-next-v2} playwright test --config=tests/e2e/playwright.config.ts",
    "test:perf": "PERF_RUNS=10 PERF_DOMAIN_A=browse PERF_DOMAIN_B=host-playground npx playwright test --config=tests/performance/playwright.config.ts tests/performance/cold-start.spec.ts",
    "test:perf:base": "PERF_RUNS=20 PERF_SAVE_BASE=1 PERF_DOMAIN_A=browse PERF_DOMAIN_B=host-playground npx playwright test --config=tests/performance/playwright.config.ts tests/performance/cold-start.spec.ts",
    "test:perf:compare": "bun tests/performance/compare.ts",
    "test:perf:compare:md": "bun tests/performance/compare.ts --markdown",
    "lint": "bunx eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dotli/eslint-config": "workspace:*",
    "@dotli/typescript-config": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "happy-dom": "^20.14.5",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "simple-statistics": "^7.12.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.1",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@dotli/config": "workspace:*",
    "@dotli/metrics": "workspace:*",
    "@dotli/protocol": "workspace:*",
    "@dotli/shared": "workspace:*",
    "@dotli/storage": "workspace:*",
    "@dotli/resolver": "workspace:*",
    "@dotli/truapi-debug": "workspace:*",
    "@dotli/ui": "workspace:*",
    "@sentry/browser": "^11.0.0",
    "@sentry/vite-plugin": "^5.4.0"
  }
}
