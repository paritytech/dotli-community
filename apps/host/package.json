{
  "name": "@dotli/host",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.6.0",
  "type": "module",
  "sideEffects": [
    "./src/boot.ts",
    "./src/landing.ts",
    "./src/main.ts",
    "./src/startup.ts"
  ],
  "scripts": {
    "build": "astro build",
    "build:prod": "astro check && astro build && node ../../scripts/compress-dist.ts",
    "dev": "astro dev",
    "test": "vitest run",
    "test:functional": "playwright test --config=tests/functional/playwright.config.ts",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:local": "E2E_PRODUCT_URL=${E2E_PRODUCT_URL:-http://localhost:5199} SIGNING_HOST_NETWORK=${SIGNING_HOST_NETWORK:-paseo-next-v2} playwright test --config=tests/e2e/playwright.config.ts",
    "test:perf": "PERF_RUNS=10 PERF_DOMAIN_A=browse PERF_DOMAIN_B=host-playground playwright test --config=tests/performance/playwright.config.ts tests/performance/cold-start.spec.ts",
    "test:perf:base": "PERF_RUNS=20 PERF_SAVE_BASE=1 PERF_DOMAIN_A=browse PERF_DOMAIN_B=host-playground playwright test --config=tests/performance/playwright.config.ts tests/performance/cold-start.spec.ts",
    "test:perf:compare": "node tests/performance/compare.ts",
    "test:perf:compare:md": "node tests/performance/compare.ts --markdown",
    "lint": "eslint .",
    "typecheck": "astro check",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --config vitest.storybook.config.ts",
    "test:vrt": "VRT=1 vitest run --config vitest.storybook.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@config/eslint": "*",
    "@config/storybook": "*",
    "@config/typescript": "*",
    "@config/vite": "*",
    "@parity/truapi": "0.24.0",
    "@playwright/test": "^1.63.0",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "multiformats": "^14.0.5",
    "playwright": "^1.63.0",
    "simple-statistics": "^7.12.1",
    "storybook": "^10.6.1",
    "storybook-solidjs-vite": "^10.7.2",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@config/astro-solid": "*",
    "@dotli/bitswap": "*",
    "@dotli/chains": "*",
    "@dotli/config": "*",
    "@dotli/content": "*",
    "@dotli/host-runtime": "*",
    "@dotli/metrics": "*",
    "@dotli/protocol": "*",
    "@dotli/resolver": "*",
    "@dotli/sandbox-wire": "*",
    "@dotli/shared": "*",
    "@dotli/storage": "*",
    "@dotli/truapi-debug": "*",
    "@dotli/truapi-debug-ui": "*",
    "@dotli/ui": "*",
    "@dotli/ui-entities": "*",
    "@dotli/ui-widgets": "*",
    "@sentry/browser": "^11.4.0",
    "@solidjs/web": "2.0.0-rc.13",
    "astro": "^7.3.6",
    "qrcode": "^1.5.4",
    "solid-js": "2.0.0-rc.13"
  }
}
