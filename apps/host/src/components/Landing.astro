// Static but for its three controls, which are islands. The logo renders here with no directive, so it ships no code.
import { LogoSymbol, LogoWordmark } from '@dotli/ui/brand';
// `.jsx`, since Astro finds a hydrated island's `.tsx` source from that extension and not from `.js`.
import { LandingAuth } from '../islands/LandingAuth.jsx';
import { LandingNav } from '../islands/LandingNav.jsx';
import { LandingRecents } from '../islands/LandingRecents.jsx';
import s from './Landing.module.css';
---

<div class={s['landing']} data-testid="landing">
  <div class={s['corner']} id="landing-auth">
    <LandingAuth client:load />
  </div>
  <div class={s['center']}>
    <div class={s['content']}>
      <LogoSymbol height={54} />
      {/* Sized and spaced as the guide's vertical lockup. */}
      <h1 class={s['title']}>
        <LogoWordmark height={25} testId="landing-wordmark" />
        <span class={s['beta']}>β</span>
      </h1>
      <p class={s['subtitle']}>The decentralized web, in your browser.</p>
      <LandingNav client:load />
      <LandingRecents client:load />
    </div>
  </div>
</div>
