// On a phone it is drawn over the sheets resting on it and stays live while one is open (`data-over-sheets`),
// so a control pressed there hands the open sheet over to its own.
// `.jsx`, since Astro finds a hydrated island's `.tsx` source from that extension and not from `.js`.
import { TopbarActions } from '../islands/TopbarActions.jsx';
import TopbarLogo from './TopbarLogo.astro';
import UrlPill from './UrlPill.astro';
import s from './Topbar.module.css';
---

<header id="topbar" class={s['topbar']} aria-label="dot.li browser bar" data-chrome data-over-sheets>
  {/* Decorative: the reveal button and the pill carry the words. */}
  <span class={s['strip']} aria-hidden="true">
    <span class={s['action']}></span>
    <span class={s['bar']}></span>
  </span>
  <div class={s['row']}>
    <TopbarLogo />
    <UrlPill />
    <TopbarActions client:load />
  </div>
  {/* Announces the offline state the capsule only shows. */}
  <span id="topbar-offline" class={s['offline']} role="status"></span>
</header>

<script>
  import { topbarStore } from '../state/topbar.js';
  import { networkHealthStore } from '../state/network-health.js';
  import {
    registerTopbarElement,
    revealTopbar,
    scheduleTopbarHide,
    TOPBAR_REVEAL_SHORTCUT,
  } from '../topbar-autohide.js';
  import { bindTopbarStatus } from '../topbar-status.js';

  const bar = document.getElementById('topbar');
  if (bar !== null) {
    registerTopbarElement(bar);
    bindTopbarStatus(bar, networkHealthStore);
    bar.addEventListener('mouseenter', revealTopbar);
    bar.addEventListener('mouseleave', scheduleTopbarHide);

    const render = (): void => {
      const { visible, autoHide } = topbarStore.get();
      bar.toggleAttribute('data-hidden', !visible);
      if (autoHide) {
        bar.setAttribute('aria-keyshortcuts', TOPBAR_REVEAL_SHORTCUT);
      } else {
        bar.removeAttribute('aria-keyshortcuts');
      }
    };
    render();
    topbarStore.subscribe(render);
  }
</script>
