// The host's top bar (`header#topbar`, the page's banner): one element that
// morphs between the open glass pill (the home link, the URL bar and the
// action group) and the collapsed status capsule. At 560 px and below it is
// the square phone bar at the foot of the screen instead (logo, address,
// More, account), which never folds away. Only the action group is
// interactive, a Solid island (TopbarActions: the actions, the More menu they
// collapse into, then the account button), hydrated at load: on the landing
// page it renders nothing.
//
// Its script sets the bar's state as attributes, which its module styles:
// `data-hidden` when the auto-hide (topbar-autohide.ts in @dotli/ui) folds it
// into the capsule, `data-tone` and `data-action` (bindTopbarStatus) for the
// capsule's bar and action dot. On `<body>` it sets `data-landing`, which
// hides the bar and which `#app` (pages/index.module.css) and the loading
// screen read. It also advertises the reveal shortcut while the bar
// auto-hides, and reveals it on hover.
import { TopbarActions } from '@dotli/ui/islands/TopbarActions';
import TopbarLogo from './TopbarLogo.astro';
import UrlPill from './UrlPill.astro';
import s from './Topbar.module.css';
---

<header id="topbar" class={s['topbar']} aria-label="dot.li browser bar" data-chrome>
  {/* The collapsed capsule: the health bar, led by the action dot. Decorative,
      the reveal button and the pill carry the words. */}
  <span class={s['strip']} aria-hidden="true">
    <span class={s['action']}></span>
    <span class={s['bar']}></span>
  </span>
  <div class={s['row']}>
    <TopbarLogo />
    <UrlPill />
    <TopbarActions client:load />
  </div>
  {/* Says "You are offline" (bindTopbarStatus), which the capsule only shows. */}
  <span id="topbar-offline" class={s['offline']} role="status"></span>
</header>

<script>
  import {
    bindTopbarStatus,
    registerTopbarElement,
    revealTopbar,
    scheduleTopbarHide,
    TOPBAR_REVEAL_SHORTCUT,
    topbarStore,
  } from '@dotli/ui';

  const bar = document.getElementById('topbar');
  if (bar !== null) {
    registerTopbarElement(bar);
    bindTopbarStatus(bar);
    bar.addEventListener('mouseenter', revealTopbar);
    bar.addEventListener('mouseleave', scheduleTopbarHide);

    const render = (): void => {
      const { visible, autoHide, landing } = topbarStore.get();
      bar.toggleAttribute('data-hidden', !visible);
      if (autoHide) {
        bar.setAttribute('aria-keyshortcuts', TOPBAR_REVEAL_SHORTCUT);
      } else {
        bar.removeAttribute('aria-keyshortcuts');
      }
      document.body.toggleAttribute('data-landing', landing);
    };
    render();
    topbarStore.subscribe(render);
  }
</script>
