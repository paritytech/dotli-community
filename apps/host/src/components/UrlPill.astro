// The topbar's URL bar (`#topbar-url`): the pill's markup, empty and hidden
// until the host knows what it shows. Its script binds it to the url-pill
// store main.ts writes (bindUrlPill in @dotli/ui), which fills in the
// product's label and TLD or a local product's host. The verification
// shield and its explainer are an island in the pill (UrlPillShield),
// hydrated once the browser is idle. bindUrlPill finds the pill and the name
// by their ids, and marks a local product's pill `data-localhost`.
import { UrlPillShield } from '@dotli/ui/islands/UrlPillShield';
import s from './UrlPill.module.css';
---

<div class={s['url']} id="topbar-url" hidden>
  <div class={s['pill']} id="url-pill">
    <UrlPillShield client:idle />
    <svg
      class={s['localhostIcon']}
      width="12"
      height="12"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m4 17 6-6-6-6m8 14h8" />
    </svg>
    <span class={s['text']} data-testid="url-pill-text">
      <span class={s['domain']} id="url-pill-domain"></span>
      <span class={s['tld']} id="url-pill-tld"></span>
    </span>
  </div>
</div>

<script>
  import { bindUrlPill } from '@dotli/ui';

  const bar = document.getElementById('topbar-url');
  if (bar !== null) {
    bindUrlPill(bar);
  }
</script>
