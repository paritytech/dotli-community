// Empty and hidden until bindUrlPill fills it from the url-pill store. bindUrlPill finds the pill and the name by id.
// `.jsx`, since Astro finds a hydrated island's `.tsx` source from that extension and not from `.js`.
import { UrlPillShield } from '../islands/UrlPillShield.jsx';
import { TerminalIcon } from '@dotli/ui/icons';
import s from './UrlPill.module.css';
---

<div class={s['url']} id="topbar-url" hidden>
  <div class={s['pill']} id="url-pill">
    <UrlPillShield client:idle />
    <TerminalIcon class={s['localhostIcon']} size={12} />
    <span class={s['text']} data-testid="url-pill-text">
      <span class={s['domain']} id="url-pill-domain"></span>
      <span class={s['tld']} id="url-pill-tld"></span>
    </span>
  </div>
</div>
