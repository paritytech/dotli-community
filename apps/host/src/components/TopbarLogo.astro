// The topbar's home link (`#topbar-home`): the Polkadot mark, the wordmark
// set as text, and the Beta tag.
import s from './TopbarLogo.module.css';

const homeUrl = import.meta.env.VITE_APP_URL ?? '/';
---

<a class={s['home']} id="topbar-home" href={homeUrl}>
  <svg class={s['mark']} width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <ellipse cx="12" cy="3.6" rx="3.3" ry="2.1"></ellipse>
    <ellipse cx="12" cy="20.4" rx="3.3" ry="2.1"></ellipse>
    <ellipse cx="19.3" cy="7.8" rx="3.3" ry="2.1" transform="rotate(60 19.3 7.8)"></ellipse>
    <ellipse cx="19.3" cy="16.2" rx="3.3" ry="2.1" transform="rotate(-60 19.3 16.2)"></ellipse>
    <ellipse cx="4.7" cy="16.2" rx="3.3" ry="2.1" transform="rotate(60 4.7 16.2)"></ellipse>
    <ellipse cx="4.7" cy="7.8" rx="3.3" ry="2.1" transform="rotate(-60 4.7 7.8)"></ellipse>
  </svg>
  <span class={s['wordmark']}>Polkadot</span>
  <span class={s['beta']}>Beta</span>
</a>
