// The bare host's root. No topbar and no loading screen, and the landing page renders at build time, so it is the first
// paint. With no `#app`, an error page takes over the whole body.
// `.jsx`, since Astro finds a hydrated island's `.tsx` source from that extension and not from `.js`.
import { AuthModalIsland } from '../features/account/signIn/AuthModalIsland.jsx';
import { OverlaysIsland } from '../shell/OverlaysIsland.jsx';
import Landing from '../features/landing/Landing.astro';
import PageHead from '../shell/PageHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead />
  </head>
  <body data-landing>
    <Landing />
    <AuthModalIsland client:idle placement="center" />
    {/* Marked, so a full-page screen keeps it. */}
    <div data-overlays>
      <OverlaysIsland client:idle={{ timeout: 1000 }} />
    </div>
    <script src="../shell/landing.ts"></script>
  </body>
</html>
