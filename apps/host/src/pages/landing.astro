// The bare host's root. No topbar and no loading screen, and the landing page renders at build time, so it is the first
// paint. With no `#app`, an error page takes over the whole body.
import { AuthModal } from '@dotli/ui/islands/AuthModal';
import { LandingPage } from '@dotli/ui/islands/LandingPage';
import PageHead from '../components/PageHead.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead />
  </head>
  <body data-landing>
    <LandingPage client:load />
    <AuthModal client:idle />
    <script src="../landing.ts"></script>
  </body>
</html>
