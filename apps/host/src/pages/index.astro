// The shell around a product, on its `<label>.<BASE_DOMAIN>` host. The bare host's root serves landing.astro instead.
import PageHead from '../shell/PageHead.astro';
import Topbar from '../shell/Topbar.astro';
import { AuthModalIsland } from '../features/account/signIn/AuthModalIsland.jsx';
import { LoadingScreenIsland } from '../features/productLoad/progress/LoadingScreenIsland.jsx';
import { OverlaysIsland } from '../shell/OverlaysIsland.jsx';
import { TopbarRevealIsland } from '../features/topbar/TopbarRevealIsland.jsx';
import s from './index.module.css';
---

<!doctype html>
<html lang="en" class={s['page']}>
  <head>
    <PageHead />
  </head>
  <body class={s['page']} data-host>
    <Topbar />
    <AuthModalIsland client:idle placement="topbar-end" />

    {/* Outside `#app`, whose content the product replaces. */}
    <LoadingScreenIsland client:load />

    <div id="app" class={s['app']}></div>
    {/* After the app frame, so it is one Tab past it. */}
    <TopbarRevealIsland client:idle />
    {/* Marked, so a full-page screen keeps it. */}
    <div data-overlays>
      <OverlaysIsland client:idle={{ timeout: 1000 }} />
    </div>
    <script src="../shell/main.ts"></script>
  </body>
</html>
