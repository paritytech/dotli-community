// The shell around a product, on its `<label>.<BASE_DOMAIN>` host. The bare host's root serves landing.astro instead.
import dbPreOpen from '../head/db-pre-open.js?inline-script';
import PageHead from '../components/PageHead.astro';
import Shell from '../components/Shell.astro';
import { ChatDock } from '../islands/ChatDock.jsx';
import { LoadingScreen } from '../islands/LoadingScreen.jsx';
import { TopbarReveal } from '../islands/TopbarReveal.jsx';
import s from './index.module.css';
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead />
    {/* Opens the shared IndexedDB during HTML parse, overlapping module loading. */}
    <script is:inline set:html={dbPreOpen} />
  </head>
  <body data-host>
    <Shell />

    <ChatDock client:idle />

    {/* Outside `#app`, whose content the product replaces. */}
    <LoadingScreen client:load />

    <div id="app" class={s['app']}></div>
    {/* After the app frame, so it is one Tab past it. */}
    <TopbarReveal client:idle />
    <script src="../main.ts"></script>
  </body>
</html>
