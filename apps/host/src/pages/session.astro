// The session window on the bare host, for its sign-in, sign-out and site list routes. No topbar and no product, only
// the logo's header over the window's content. The island renders at build time on its first view, so Connecting is
// the first paint.
import { Logo } from '@dotli/ui/brand';
// `.jsx`, since Astro finds a hydrated island's `.tsx` source from that extension and not from `.js`.
import { OverlaysIsland } from '../shell/OverlaysIsland.jsx';
import { SessionWindowIsland } from '../features/signInWindow/SessionWindowIsland.jsx';
import PageHead from '../shell/PageHead.astro';
import s from './session.module.css';
---

<!doctype html>
<html lang="en">
  <head>
    <PageHead />
  </head>
  <body class={s['page']} data-session-window>
    <header class={s['header']}>
      <Logo class={s['logo']} variant="full" beta height={22} />
    </header>
    <SessionWindowIsland client:load />
    <div class={s['balance']} aria-hidden="true"></div>
    {/* Marked, so a full-page screen keeps it. */}
    <div data-overlays>
      <OverlaysIsland client:idle={{ timeout: 1000 }} />
    </div>
    <script src="../shell/session.ts"></script>
  </body>
</html>
