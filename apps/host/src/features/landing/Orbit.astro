// The landing page's backdrop: dots circling three rings on a tilted floor, linked to the centre and to each other.
// HTML and CSS only, so it ships no code.
import s from './Orbit.module.css';

// Each dot's angle on its ring at rest.
const INNER = { c0: -78, c1: 30, c2: 158 };
const MIDDLE = { s0: -34, s1: 92, s2: 221, s3: 283, s4: 17, s5: 148 };

const RINGS = [
  { ring: 'inner', starts: Object.values(INNER) },
  { ring: 'middle', starts: Object.values(MIDDLE) },
  { ring: 'outer', starts: [3, 41, 118, 139, 197, 262, 289, 344] },
];

// The centre links to every inner dot, and some dots link to each other.
const LINKS = [
  ...Object.values(INNER).map(start => ({ from: { ring: 'centre', start: 0 }, to: { ring: 'inner', start } })),
  { from: { ring: 'inner', start: INNER.c0 }, to: { ring: 'middle', start: MIDDLE.s3 } },
  { from: { ring: 'inner', start: INNER.c0 }, to: { ring: 'middle', start: MIDDLE.s0 } },
  { from: { ring: 'middle', start: MIDDLE.s0 }, to: { ring: 'middle', start: MIDDLE.s3 } },
  { from: { ring: 'inner', start: INNER.c1 }, to: { ring: 'middle', start: MIDDLE.s1 } },
  { from: { ring: 'inner', start: INNER.c2 }, to: { ring: 'middle', start: MIDDLE.s2 } },
  { from: { ring: 'inner', start: INNER.c2 }, to: { ring: 'middle', start: MIDDLE.s1 } },
];
---

<div class={s['orbit']} aria-hidden="true">
  <div class={s['stage']}>
    <div class={s['plane']}>
      {RINGS.map(({ ring, starts }) => (
        <div class={s['ring']} data-ring={ring}>
          {starts.map(start => (
            <div class={s['dot']} style={`--start: ${start}deg`} />
          ))}
        </div>
      ))}
      {LINKS.map(({ from, to }) => (
        <div
          class={s['link']}
          data-from={from.ring}
          data-to={to.ring}
          style={`--from-start: ${from.start}deg; --to-start: ${to.start}deg`}
        />
      ))}
      <div class={s['centre']}></div>
    </div>
  </div>
</div>
