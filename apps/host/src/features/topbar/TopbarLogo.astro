// Both forms render, and the bar's width picks one from CSS, so the narrow layout needs no script. The link carries the
// name, since the symbol alone is hidden from assistive technology.
import { Logo } from '@dotli/ui/brand';
import s from './TopbarLogo.module.css';

const homeUrl = import.meta.env.VITE_APP_URL ?? '/';
---

<a class={s['home']} id="topbar-home" href={homeUrl} aria-label="Polkadot">
  <Logo class={s['full']} variant="full" beta height={20} />
  <Logo class={s['symbol']} variant="symbol" beta height={20} />
</a>
