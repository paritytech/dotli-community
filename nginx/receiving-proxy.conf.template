# The configured receiver is bound to one product origin, never the wildcard.
location ^~ /__receiving/ {
    if ($host != "${RECEIVING_HOST}") { return 404; }
    client_max_body_size 2m;
    client_body_timeout 10s;
    # Receiver paths contain device identifiers; do not retain them in access logs.
    access_log off;
    # The relay owns CORS; do not inherit the static host's wildcard CORS header.
    add_header X-Content-Type-Options nosniff always;
    proxy_pass http://127.0.0.1:${RECEIVING_PORT}/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;
    proxy_connect_timeout 5s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_redirect off;
}
