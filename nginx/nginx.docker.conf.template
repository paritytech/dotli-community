# Docker profile, rendered by docker/entrypoint.sh with envsubst. Keep in sync with nginx.conf.template by hand.
# Differs only in plain HTTP on one port, no rate limiting, no Sentry tunnel, and serving the runtime network config.
#   ${DOMAIN}         host build, and the protocol build under /p/
#   host.${DOMAIN}    protocol build, kept for one release for shells cached by the previous one
#   *.${DOMAIN}       host build
#   *.app.${DOMAIN}   app build

server {
    listen ${PORT};
    server_name ${DOMAIN};

    root ${WEBROOT}/host;
    index index.html;
    # Reaches only the locations with no add_header of their own, such as the landing page and the shell.
    include /etc/nginx/snippets/dotli-headers-host.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    set $csp_ancestors "${CSP}";
    set $protocol_root "${WEBROOT}/protocol";
    include /etc/nginx/snippets/dotli-protocol-frame.conf;
    include /etc/nginx/snippets/dotli-session-page.conf;
    include /etc/nginx/snippets/dotli-session-file.conf;

    # The landing page. Every other path gets the shell, which opens the product `/<label>` names and sends a URL with no
    # product back here.
    location = / {
        try_files /landing.html =404;
    }

    location = /__preview {
        set $csp_ancestors "${CSP}";
        include /etc/nginx/snippets/dotli-headers-iframeable.conf;
        try_files /index.html =404;
    }

    # The host's chunks and workers, which carry COEP so the cross-origin isolated /__preview page can start them.
    include /etc/nginx/snippets/dotli-assets-preview.conf;

    include /etc/nginx/snippets/dotli-runtime-network.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen ${PORT};
    server_name *.app.${DOMAIN};

    set $csp_ancestors "${CSP}";
    include /etc/nginx/snippets/dotli-headers-iframeable.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    root ${WEBROOT}/app;
    index index.html;

    include /etc/nginx/snippets/dotli-assets-iframeable.conf;
    include /etc/nginx/snippets/dotli-sw-app.conf;

    include /etc/nginx/snippets/dotli-runtime-network.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen ${PORT};
    server_name host.${DOMAIN};

    set $csp_ancestors "${CSP}";
    include /etc/nginx/snippets/dotli-headers-iframeable.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    set $protocol_root "${WEBROOT}/protocol";
    root $protocol_root;
    index index.html;

    include /etc/nginx/snippets/dotli-protocol-frame.conf;
    include /etc/nginx/snippets/dotli-assets-iframeable.conf;

    include /etc/nginx/snippets/dotli-runtime-network.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    # Revalidated, so a deploy reaches every shell at once. A cached older frame never sends `listening` and fails.
    # `expires` rather than add_header, which would drop the server block's headers here.
    location / {
        expires -1;
        try_files $uri /index.html;
    }
}

server {
    listen ${PORT};
    server_name *.${DOMAIN};

    include /etc/nginx/snippets/dotli-headers-host.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    root ${WEBROOT}/host;

    include /etc/nginx/snippets/dotli-assets-host.conf;
    include /etc/nginx/snippets/dotli-sw-host.conf;
    include /etc/nginx/snippets/dotli-session-file.conf;

    include /etc/nginx/snippets/dotli-runtime-network.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}
