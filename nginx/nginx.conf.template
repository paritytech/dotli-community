# ${DOMAIN}: DO NOT EDIT THE INSTALLED COPY. Rendered per env by `make deploy-nginx` with envsubst.
# ${RL} and ${SENTRY} are "" to enable their lines or "#" to comment them out. ${RL} is on for the production
# domains, ${SENTRY} when SENTRY_DSN is set. ${SNIPPETS} is the env's own copy of nginx/snippets/.
#   host.${DOMAIN}    protocol build
#   *.${DOMAIN}       host build
#   *.app.${DOMAIN}   app build

# /assets/ gets its own zone with a larger burst, because a cold load fetches ~150 chunks at once and a domain's
# three origins share the per-IP bucket. Each map gives the other zone's paths an empty key, which nginx does not
# count. Map variables are per domain because every site shares one http block. 429 so rejections read as rate
# limiting, not a server fault.
${RL}map $uri $${ZONE}_key {
${RL}    ~^/assets/ "";
${RL}    default    $binary_remote_addr;
${RL}}
${RL}map $uri $${ZONE}_assets_key {
${RL}    ~^/assets/ $binary_remote_addr;
${RL}    default    "";
${RL}}
${RL}limit_req_zone $${ZONE}_key        zone=${ZONE}:10m        rate=15r/s;
${RL}limit_req_zone $${ZONE}_assets_key zone=${ZONE}_assets:10m rate=64r/s;

server {
    listen 80;
    server_name ${DOMAIN} *.${DOMAIN} host.${DOMAIN} *.app.${DOMAIN};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include ${SNIPPETS}/dotli-ssl.conf;

    root ${WEBROOT}/host;
    index index.html;

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include ${SNIPPETS}/dotli-sentry-tunnel.conf;

    # The landing page. Every other path gets the shell, which sends a URL with no product back here.
    location = / {
        try_files /landing.html =404;
    }

    location = /__preview {
        set $csp_ancestors "revx.dev stg.revx.dev http://localhost:*";
        include ${SNIPPETS}/dotli-headers-iframeable.conf;
        try_files /index.html =404;
    }

    include ${SNIPPETS}/dotli-host-version.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name *.app.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include ${SNIPPETS}/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    set $csp_ancestors "${DOMAIN} *.${DOMAIN} *.app.${DOMAIN}";
    include ${SNIPPETS}/dotli-headers-iframeable.conf;
    include ${SNIPPETS}/dotli-precompressed.conf;

    root ${WEBROOT}/app;
    index index.html;

    include ${SNIPPETS}/dotli-assets-iframeable.conf;
    include ${SNIPPETS}/dotli-sw-app.conf;

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include ${SNIPPETS}/dotli-sentry-tunnel.conf;

    include ${SNIPPETS}/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name host.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include ${SNIPPETS}/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    set $csp_ancestors "${DOMAIN} *.${DOMAIN} *.app.${DOMAIN} revx.dev stg.revx.dev http://localhost:*";
    include ${SNIPPETS}/dotli-headers-iframeable.conf;
    include ${SNIPPETS}/dotli-precompressed.conf;

    root ${WEBROOT}/protocol;
    index index.html;

    include ${SNIPPETS}/dotli-assets-iframeable.conf;

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include ${SNIPPETS}/dotli-sentry-tunnel.conf;

    include ${SNIPPETS}/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}

server {
    listen 443 ssl http2;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include ${SNIPPETS}/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    include ${SNIPPETS}/dotli-headers-host.conf;
    include ${SNIPPETS}/dotli-precompressed.conf;

    root ${WEBROOT}/host;

    include ${SNIPPETS}/dotli-assets-host.conf;
    include ${SNIPPETS}/dotli-sw-host.conf;

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include ${SNIPPETS}/dotli-sentry-tunnel.conf;

    include ${SNIPPETS}/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}
