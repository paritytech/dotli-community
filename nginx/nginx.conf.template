# ${DOMAIN} NGINX configuration — DO NOT EDIT THE INSTALLED COPY.
#
# Rendered per-env from nginx/nginx.conf.template by `make deploy-nginx`
# (envsubst). Substituted tokens: ${DOMAIN}, ${WEBROOT}, ${ZONE}, ${RL},
# ${SENTRY}, ${SENTRY_INGEST}, ${SENTRY_PROJECT}.
# ${RL} is "" to enable rate-limiting (paseo.li / testnet.li) or "#" to
# comment it out (all other envs). ${SENTRY} works the same for the optional
# Sentry tunnel lines: "" when SENTRY_DSN is set (with ${SENTRY_INGEST} and
# ${SENTRY_PROJECT} cut from the DSN), "#" when it is not - the tunnel
# snippet is then neither included nor uploaded.
# The Media TURN route is always rendered; its Cloudflare key id and token live
# only in /etc/nginx/dotli-private/${DOMAIN}-media-turn.conf, written by
# `make deploy-nginx` (empty, so the route answers 503, when unset).
# nginx's own $variables are left intact.
#
# Three-build architecture:
#   host.${DOMAIN}    → Shared protocol host (smoldot, shared chain cache)
#   *.${DOMAIN}       → Host build (topbar, routing shell, bridge)
#   *.app.${DOMAIN}   → App build  (CID from subdomain, P2P fetch, render)
#
# SSL cert covers ${DOMAIN}, *.${DOMAIN}, *.app.${DOMAIN} (single multi-SAN
# cert at /etc/letsencrypt/live/${DOMAIN}/). Web roots live under ${WEBROOT}/*.

# Rate-limiting zones (only enabled on the production domains).
#
# /assets/ has its own zone with a larger burst: one cold page load fetches
# ~150 hashed chunks within a second or two, and the host, protocol and app
# origins of a domain share the per-IP bucket, so the burst leaves room for a
# hard reload or several apps opened in a row. Rejections are 429 so they read
# as rate limiting rather than as a server fault. Each map leaves the
# other zone's paths with an empty key, which nginx does not count, so every
# request counts against exactly one zone. The map variables are per domain
# because every site config shares one http block.
${RL}map $uri $${ZONE}_key {
${RL}    ~^/assets/ "";
${RL}    default    $binary_remote_addr;
${RL}}
${RL}map $uri $${ZONE}_assets_key {
${RL}    ~^/assets/ $binary_remote_addr;
${RL}    default    "";
${RL}}
${RL}limit_req_zone $${ZONE}_key        zone=${ZONE}:10m        rate=15r/s;
${RL}limit_req_zone $${ZONE}_assets_key zone=${ZONE}_assets:10m rate=64r/s;

# Media TURN credentials: always limited, per client IP, on every env. Each
# shell tab mints at most once per credential lifetime plus retries.
limit_req_zone $binary_remote_addr zone=${ZONE}_media_turn:1m rate=6r/m;

# ────────────────────────────────────────────────────────────
# HTTP → HTTPS redirect
# ────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name ${DOMAIN} *.${DOMAIN} host.${DOMAIN} *.app.${DOMAIN};
    return 301 https://$host$request_uri;
}

# ────────────────────────────────────────────────────────────
# Root domain: ${DOMAIN} — Landing page
# ────────────────────────────────────────────────────────────

server {
    listen 443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/dotli-ssl.conf;

    root ${WEBROOT}/host;
    index index.html;

    resolver 127.0.0.53 valid=300s ipv6=off;
    resolver_timeout 5s;
    include /etc/nginx/snippets/dotli-identity-proxy.conf;
    location = /__dotli-media/turn {
        limit_req zone=${ZONE}_media_turn burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/dotli-private/${DOMAIN}-media-turn.conf;
        include /etc/nginx/snippets/dotli-media-turn.conf;
    }

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include /etc/nginx/snippets/dotli-sentry-tunnel.conf;

    location = /__preview {
        set $csp_ancestors "revx.dev stg.revx.dev http://localhost:*";
        include /etc/nginx/snippets/dotli-headers-iframeable.conf;
        try_files /index.html =404;
    }

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri $uri/ /index.html;
    }
}

# ────────────────────────────────────────────────────────────
# App build: *.app.${DOMAIN} — CID content fetching & rendering
# ────────────────────────────────────────────────────────────

server {
    listen 443 ssl http2;
    server_name *.app.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    set $csp_ancestors "${DOMAIN} *.${DOMAIN} *.app.${DOMAIN}";
    include /etc/nginx/snippets/dotli-headers-iframeable.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    root ${WEBROOT}/app;
    index index.html;

    include /etc/nginx/snippets/dotli-assets-iframeable.conf;
    include /etc/nginx/snippets/dotli-sw-app.conf;

    location ^~ /__dotli-identity { return 404; }
    location ^~ /__dotli-media { return 404; }

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include /etc/nginx/snippets/dotli-sentry-tunnel.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}

# ────────────────────────────────────────────────────────────
# Shared protocol build: host.${DOMAIN} — smoldot / shared cache origin
# ────────────────────────────────────────────────────────────

server {
    listen 443 ssl http2;
    server_name host.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    set $csp_ancestors "${DOMAIN} *.${DOMAIN} *.app.${DOMAIN} revx.dev stg.revx.dev http://localhost:*";
    include /etc/nginx/snippets/dotli-headers-iframeable.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    root ${WEBROOT}/protocol;
    index index.html;

    include /etc/nginx/snippets/dotli-assets-iframeable.conf;

    location ^~ /__dotli-identity { return 404; }
    location ^~ /__dotli-media { return 404; }

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include /etc/nginx/snippets/dotli-sentry-tunnel.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}

# ────────────────────────────────────────────────────────────
# Host build: *.${DOMAIN} — Shell with topbar, routing, bridge
# ────────────────────────────────────────────────────────────

server {
    listen 443 ssl http2;
    server_name *.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    include /etc/nginx/snippets/dotli-ssl.conf;

    ${RL}limit_req zone=${ZONE} burst=30 nodelay;
    ${RL}limit_req zone=${ZONE}_assets burst=512 nodelay;
    ${RL}limit_req_status 429;
    include /etc/nginx/snippets/dotli-headers-host.conf;
    include /etc/nginx/snippets/dotli-precompressed.conf;

    root ${WEBROOT}/host;

    include /etc/nginx/snippets/dotli-assets-host.conf;
    include /etc/nginx/snippets/dotli-sw-host.conf;

    resolver 127.0.0.53 valid=300s ipv6=off;
    resolver_timeout 5s;
    include /etc/nginx/snippets/dotli-identity-proxy.conf;
    location = /__dotli-media/turn {
        limit_req zone=${ZONE}_media_turn burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/dotli-private/${DOMAIN}-media-turn.conf;
        include /etc/nginx/snippets/dotli-media-turn.conf;
    }

    ${SENTRY}set $sentry_ingest  "${SENTRY_INGEST}";
    ${SENTRY}set $sentry_project "${SENTRY_PROJECT}";
    ${SENTRY}include /etc/nginx/snippets/dotli-sentry-tunnel.conf;

    include /etc/nginx/snippets/dotli-host-version.conf;

    location / {
        try_files $uri /index.html;
    }
}
